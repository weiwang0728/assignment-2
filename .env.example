# Your validator deploy command prints this URL. Replace <workspace> with your
# Modal workspace slug and keep the /v1 suffix.
VALIDATOR_BASE_URL=https://<workspace>--hw2-validator-model-validatorserver-serve.modal.run/v1

# Your own Modal proxy token in combined form: <token-id>.<token-secret>.
# This is needed to call the endpoint, but not to deploy it.
VALIDATOR_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx

# Stable alias exposed by infrastructure/validator_model.py.
VALIDATOR_MODEL=validator

# The generation deploy prints one URL for each class. Append /v1 to each URL.
GENERATION_QWEN_BASE_URL=https://<workspace>--hw2-generation-models-qwenserver-serve.modal.run/v1
GENERATION_MINISTRAL_BASE_URL=https://<workspace>--hw2-generation-models-ministralserver-serve.modal.run/v1
GENERATION_GLM_BASE_URL=https://<workspace>--hw2-generation-models-glmserver-serve.modal.run/v1

# The same workspace proxy token authenticates all three generation endpoints.
GENERATION_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx

# Optional Docker-backend overrides when endpoints use different API keys.
# GENERATION_QWEN_API_KEY=your-qwen-key
# GENERATION_MINISTRAL_API_KEY=your-ministral-key
# GENERATION_GLM_API_KEY=your-glm-key
# Docker backend: uv run --extra docker python -m workflow generate --backend docker
# Keep credentials on the host; do not pass this file to agent containers.
