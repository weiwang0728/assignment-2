FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    matplotlib==3.10.5 \
    numpy==2.3.2 \
    pandas==2.3.1 \
    pillow==11.3.0 \
    scipy==1.16.1 \
    seaborn==0.13.2
ENV MPLBACKEND=Agg PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /workspace
CMD ["sleep", "infinity"]
